{
  "experiment": "mixllm_comparison_80_20",
  "description": "Stage 2 test only: MixLLM's 80/20 split and 11 models, for a fair comparison. The project design stays 30/60/10 with 5 models (experiment_historical.json).",
  "seeds": [
    11,
    23,
    37,
    53,
    71
  ],
  "data": {
    "model_keys_primary": [
      "gpt-4-1106-preview",
      "gpt-3.5-turbo-1106",
      "claude-v1",
      "claude-v2",
      "claude-instant-v1",
      "meta/llama-2-70b-chat",
      "mistralai/mixtral-8x7b-chat",
      "zero-one-ai/Yi-34B-Chat",
      "WizardLM/WizardLM-13B-V1.2",
      "meta/code-llama-instruct-34b-chat",
      "mistralai/mistral-7b-chat"
    ],
    "reference_model": "gpt-4-1106-preview",
    "offline_fraction": 0.8,
    "online_fraction": 0.0,
    "test_fraction": 0.2,
    "validation_fraction_of_offline": 0.0
  },
  "router": {
