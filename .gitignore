.DS_Store
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.env
.env.*
!.env.example
node_modules/

# Local RouterBench downloads; retain provenance and split manifests in Git.
data/*.pkl

# Local experimental planning document.
/EXPERIMENT_PROTOCOL.md

# Rebuilt by src/data/build_dataset.py; the cleaning reports stay in Git.
data/processed/*
!data/processed/*.report.json
data/df5_filtered.csv

# BERT numbers of every question, rebuilt by src/routing/embeddings.py.
data/embeddings/*.npz

# Phase 5: regenerable caches and the local Besu node (data, keys, throw-away dev wallet)
results/phase5/cache/
results/phase5/logs/
results/phase5/logs_all.txt
infrastructure/besu/data/node/
infrastructure/besu/data/networkFiles/keys/
infrastructure/besu/dev_wallet.json

# SuperGPQA download, rebuilt by src/data/supergpqa.py; the question batches stay in Git.
data/supergpqa/*
!data/supergpqa/batches/
